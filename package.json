{
  "name": "dawn-tick",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "晓刻 DawnTick：课表与日程提醒工具",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r --if-present test && node --test tools/release/plan.test.mjs tools/release/ci-gate.test.mjs tools/design/check-a11y.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "version:current": "node tools/release/version.mjs --current",
    "version:set": "node tools/release/version.mjs",
    "version:check": "node tools/release/version.mjs --check",
    "ui:smoke": "node tools/verify/smoke-ui.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
