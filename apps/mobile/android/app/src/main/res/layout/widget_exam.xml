<?xml version="1.0" encoding="utf-8"?>
<!-- 每行固定 @dimen/widget_row_height，行数由 WidgetRenderer 按可用高度决定。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/widget_root_padding"
    android:background="@drawable/widget_bg_light">

    <TextView
        android:id="@+id/widget_exam_label"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_header_height"
        android:gravity="center_vertical"
        android:textSize="11sp"
        android:textColor="#8A8A8A"
        android:text="@string/widget_exam_label" />

    <TextView
        android:id="@+id/widget_row1"
        style="@style/WidgetRow" />

    <TextView
        android:id="@+id/widget_row2"
        style="@style/WidgetRow" />

    <TextView
        android:id="@+id/widget_exam_days"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_count_height"
        android:gravity="center_vertical"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#B3261E" />
</LinearLayout>
