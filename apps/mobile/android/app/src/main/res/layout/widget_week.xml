<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg_light">

    <TextView
        android:id="@+id/widget_week_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#8A8A8A"
        android:text="@string/widget_week_label" />

    <TextView
        android:id="@+id/widget_week_row1"
        style="@style/WidgetRow" />

    <TextView
        android:id="@+id/widget_week_row2"
        style="@style/WidgetRow" />

    <TextView
        android:id="@+id/widget_week_row3"
        style="@style/WidgetRow" />

    <TextView
        android:id="@+id/widget_week_row4"
        style="@style/WidgetRow" />

    <TextView
        android:id="@+id/widget_week_row5"
        style="@style/WidgetRow" />

    <TextView
        android:id="@+id/widget_week_row6"
        style="@style/WidgetRow" />

    <TextView
        android:id="@+id/widget_week_row7"
        style="@style/WidgetRow" />
</LinearLayout>
